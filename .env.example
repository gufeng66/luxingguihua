# DeepSeek（OpenAI 兼容接口）
# 申请地址：https://platform.deepseek.com/
# OPENAI_API_KEY=sk-your-deepseek-api-key
# OPENAI_BASE_URL=https://api.deepseek.com

# Fit2Cloud 网关（OpenAI 兼容）；模型名见 planner/llm.py 的 f2c-deepseek-v4-flash
OPENAI_API_KEY=sk-your-fit2cloud-api-key
OPENAI_BASE_URL=https://ai.fit2cloud.cn/gateway/v1

# 高德 Web Service Key
# 申请地址：https://lbs.amap.com/api/webservice/create-project-and-key
AMAP_WEBSERVICE_KEY=your_amap_webservice_key

# 浏览器 CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 12306 MCP（不填则用仓库默认公开地址；演示降级可改成无效 URL）
# MCP_12306_URL=https://mcp.api-inference.modelscope.net/4654213017684d/mcp

# 子智能体调度超时（秒），只覆盖 astream，不含 MCP 连接
DISPATCH_TIMEOUT_SECONDS=360

# POST /api/plan 限流（单进程，每分钟次数）。不设则默认 8
# PLAN_RATE_PER_MINUTE=8
# 设置后请求必须带请求头 X-API-Key。本机页面不设此项
# PLAN_API_KEY=

# final.timings.cost_usd 用的单价（美元 / 百万 token）。不设则为 0
# TOKEN_USD_PER_M_IN=
# TOKEN_USD_PER_M_OUT=

# LangSmith 过程可视化（https://smith.langchain.com ）
# 不填 KEY 则关闭 tracing，规划照常运行
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=travel-planner
# 仅当无法自动生成 trace URL 时需要
# LANGSMITH_ORG_ID=
