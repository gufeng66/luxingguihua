# DeepSeek 官方接口（OpenAI 兼容）。模型名是 planner/llm.py 里的 deepseek-flash
# 申请地址：https://platform.deepseek.com/
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com

# 开放规则检索。不填则行程照出，开放时间标为未核实
# TAVILY_API_KEY=

# 高德 Web Service Key
# 申请地址：https://lbs.amap.com/api/webservice/create-project-and-key
AMAP_WEBSERVICE_KEY=your_amap_webservice_key

# 浏览器 CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 12306 MCP（不填则用仓库默认公开地址；演示降级可改成无效 URL）
# MCP_12306_URL=https://mcp.api-inference.modelscope.net/4654213017684d/mcp

# 一次规划的工作预算（秒）。最后 PLAN_CLOSEOUT_SECONDS 只做落盘和清理，不再发外部请求
# PLAN_BUDGET_SECONDS=240
# PLAN_CLOSEOUT_SECONDS=10
# PLAN_MAX_INFLIGHT=2

# POST /api/plan 限流（单进程，每分钟次数）。不设则默认 8
# PLAN_RATE_PER_MINUTE=8
# 设置后 API 接受 X-API-Key；页面可输入服务访问口令建立 HttpOnly 会话。
# 对外 HTTPS 部署必须设 PLAN_COOKIE_SECURE=1。
# PLAN_API_KEY=
# PLAN_SESSION_TTL_SECONDS=28800
# PLAN_COOKIE_SECURE=0

# final.timings.cost_usd 用的单价（美元 / 百万 token）。未配置有效单价时 cost_usd=null，前端显示“成本未知”，不能视为零成本。
# TOKEN_USD_PER_M_IN=
# TOKEN_USD_PER_M_OUT=

# LangSmith 过程可视化（https://smith.langchain.com ）
# 不填 KEY 则关闭 tracing，规划照常运行
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=travel-planner
# 仅当无法自动生成 trace URL 时需要
# LANGSMITH_ORG_ID=

# SSE 心跳间隔（秒）。长时间没有事件时保活，避免代理断流
# SSE_HEARTBEAT_SECONDS=15
# 一次 /api/plan SSE 的总超时（秒）。默认按 PLAN_BUDGET_SECONDS + PLAN_CLOSEOUT_SECONDS + 30 计算
# 超时后发送 error(code=sse_timeout) 并释放并发名额
# SSE_TOTAL_TIMEOUT_SECONDS=280
# 取消后等待子任务收尾的时间（秒）。超出窗口仍存活的任务记为 subagent_leak，不再宣称资源已完全释放
# PLAN_CLEANUP_SECONDS=5
# 子智能体调度超时（秒）
# DISPATCH_TIMEOUT_SECONDS=360
# 设为 1 时地图与票务子任务强制串行（先票务后地图），用于排查并发问题
# FORCE_SERIAL=
# 单次票务工具查询超时（秒）。与剩余工作预算取较小值
# TICKET_TOOL_TIMEOUT_SECONDS=30

# 真实黄金集门禁：未同时设置这两项时只记录 blocked，不发起外部调用。
# 每次真跑前必须由获授权的操作者明确确认费用上限。
# GOLDEN_LIVE_APPROVED=1
# GOLDEN_COST_LIMIT_USD=
