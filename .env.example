# DeepSeek（OpenAI 兼容接口）
# 申请地址：https://platform.deepseek.com/
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com

# 高德 Web Service Key
# 申请地址：https://lbs.amap.com/api/webservice/create-project-and-key
AMAP_WEBSERVICE_KEY=your_amap_webservice_key

# 浏览器 CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# LangSmith 过程可视化（https://smith.langchain.com ）
# 不填 KEY 则关闭 tracing，规划照常运行
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=travel-planner
# 仅当无法自动生成 trace URL 时需要
# LANGSMITH_ORG_ID=
