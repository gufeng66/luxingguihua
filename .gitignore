# =============================================================================
# 旅游规划多智能体 — Git 忽略规则
# =============================================================================

# ----- 密钥与本地环境（绝不能提交）-----
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# 高德 Skill 本地配置（含 Web Service Key）
**/amap-lbs-skill/config.json

# ----- 运行产物 -----
workspace/results/*
!workspace/results/.gitkeep
!workspace/results/maps/
workspace/results/maps/*
!workspace/results/maps/.gitkeep
!workspace/results/snapshots/
workspace/results/snapshots/*
!workspace/results/snapshots/.gitkeep

# 历史遗留根目录 results（若存在）
/results/*
!/results/.gitkeep

# 日志与临时文件
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.orig
*~
*.pid

# ----- 依赖 -----
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
__pypackages__/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.uv/

# Node（任意目录，含 amap-lbs-skill）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak
# 在仓库根跑高德脚本时的临时输出（skill 目录内另有同名规则）
/node_err.txt
/out.txt
/test_out.txt
/large_tool_results/

# ----- 测试 / 类型检查 / 覆盖率 -----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.cache/
.ipynb_checkpoints/

# ----- IDE / 编辑器 / OS -----
.idea/
.vscode/
*.code-workspace
.vs/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
ehthumbs.db

# 架构图生成工作目录（可交互图单独放 docs/）
.archify/

# ----- AI / 本地助手缓存（勿提交）-----
.workbuddy/
.cursor/
