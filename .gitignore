# =============================================================================
# 旅游规划多智能体 — Git 忽略规则
# =============================================================================

# ----- 密钥与本地环境（绝不能提交）-----
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# 高德 Skill 本地配置（可能含 Web Service Key）
amap-lbs-skill/config.json

# ----- 运行产物 -----
workspace/results/*
!workspace/results/.gitkeep
!workspace/results/maps/
workspace/results/maps/*
!workspace/results/maps/.gitkeep

# 历史遗留根目录 results（若存在）
/results/*.md
/results/*.html
/results/*.svg
/results/*.json
!/results/.gitkeep

# 日志与临时文件
*.log
*.tmp
*.temp
*.bak
*.swp
*~

